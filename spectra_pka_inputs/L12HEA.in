# ================================================================
# CONTROL PARAMETERS
# ================================================================

# Flux normalization type:
#   1 = flux is per unit lethargy (dφ/d(lnE))
#   2 = flux is per energy group (φ_j in n/cm²/s)
flux_norm_type=2

# PKA data file format type:
#   2 = standard NJOY-GROUPR output format
pka_filetype=2

# Enable per-reaction-type DPA calculations
# (This gives the crucial per-channel breakdown from Gilbert 2018)
do_mtd_sums=.true.

# Enable (n,γ) neutron-capture recoil estimate
# (Uses parent/daughter masses defined above)
do_ngamma_estimate=.t.

# Enable global summed PKA distributions
# (sum over all elements → total PKA spectrum for the alloy)
do_global_sums=.t.

# Exclude light particles (p, α, d, t) from total PKA spectrum
# (They produce different damage types; handle separately)
do_exclude_light_from_total=.t.

# Total number of isotope input files
number_pka_files=47

# Flux rescaling value (total integrated flux, n/cm²/s)
# Default: 3.25e14 (typical PWR value from SPECTRA-PKA test)
# REPLACE with actual value from Geant4 transport simulation!
flux_rescale_value=3.25e+14

# Maximum number of recoil species to track
# (for multi-element alloys, need higher value)
max_global_recoils=800

# Energy bin structure appears once per PKA data file
# (standard for TENDL PKA data files)
energies_once_perfile=.t.

# Threshold displacement energy for NRT-dpa calculation (eV)
# Using 40 eV (standard for Ni-based alloys)
assumed_Ed=40.0