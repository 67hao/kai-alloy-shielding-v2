# ================================================================
# SPECTRA-PKA input for: FeCoNiCrAl0.3
# Source paper: JALCOM (2025) — CO2/CO oxidation study
# Composition (at%): {'Fe': 23.256, 'Co': 23.256, 'Ni': 23.256, 'Cr': 23.256, 'Al': 6.977}
# Threshold displacement energy Ed = 40 eV
# Generated by: generate_spectra_pka_inputs.py
# ================================================================

# Path to neutron energy spectrum file
# (replace with Geant4-generated spectrum for LFR conditions)
flux_filename="fluxes_specter.dat"

# Output file prefix — all results will be FeCoNiCrAl03_*.out
results_stub="FeCoNiCrAl03"

# Number of data columns per isotope line
num_columns=6

# Column definitions:
#   pka_filename         = path to NJOY recoil cross-section file
#   pka_ratios           = atomic fraction of this isotope in alloy
#   parent_ele           = element symbol of target
#   parent_num           = mass number A of target
#   ngamma_parent_mass   = atomic mass of target isotope (amu)
#   ngamma_daughter_mass  = atomic mass of (n,γ) product (amu)
columns= pka_filename pka_ratios parent_ele parent_num ngamma_parent_mass ngamma_daughter_mass

